{
  "schema": "mathml_visible_content_vectors.v1",
  "purpose": "Shared vectors for the usable-content gate: MathmlContent.java (MathML and OMML) and scripts/transpect/mathml_content.py (MathML). A token counts only if it holds a code point outside Unicode general categories Cc, Cf, Zs, Zl, Zp (and not the known MathType artifact U+EF0A). This is a visible-content gate, not formula equivalence.",
  "unicode_note": "Each implementation uses its runtime Unicode database (Java 25: Unicode 16; Python 3.9: Unicode 13). Code points below have the same category in both; characters assigned after Unicode 13 may differ and are not covered.",
  "code_points": [
    {"cp": "U+0009", "visible": false, "note": "tab, Cc"},
    {"cp": "U+000A", "visible": false, "note": "line feed, Cc"},
    {"cp": "U+0020", "visible": false, "note": "space, Zs"},
    {"cp": "U+0085", "visible": false, "note": "next line, Cc; Java and Python previously disagreed"},
    {"cp": "U+00A0", "visible": false, "note": "no-break space, Zs"},
    {"cp": "U+00AD", "visible": false, "note": "soft hyphen, Cf"},
    {"cp": "U+061C", "visible": false, "note": "Arabic letter mark, Cf"},
    {"cp": "U+180E", "visible": false, "note": "Mongolian vowel separator, Cf"},
    {"cp": "U+2003", "visible": false, "note": "em space, Zs (emitted for mspace 1em)"},
    {"cp": "U+2006", "visible": false, "note": "six-per-em space, Zs (emitted for mspace 0.16em)"},
    {"cp": "U+200B", "visible": false, "note": "zero width space, Cf"},
    {"cp": "U+200D", "visible": false, "note": "zero width joiner, Cf"},
    {"cp": "U+200E", "visible": false, "note": "left-to-right mark, Cf"},
    {"cp": "U+2028", "visible": false, "note": "line separator, Zl"},
    {"cp": "U+2029", "visible": false, "note": "paragraph separator, Zp"},
    {"cp": "U+202F", "visible": false, "note": "narrow no-break space, Zs"},
    {"cp": "U+205F", "visible": false, "note": "medium mathematical space, Zs"},
    {"cp": "U+2060", "visible": false, "note": "word joiner, Cf"},
    {"cp": "U+2061", "visible": false, "note": "function application, Cf"},
    {"cp": "U+2062", "visible": false, "note": "invisible times, Cf"},
    {"cp": "U+2063", "visible": false, "note": "invisible separator, Cf"},
    {"cp": "U+2064", "visible": false, "note": "invisible plus, Cf"},
    {"cp": "U+3000", "visible": false, "note": "ideographic space, Zs"},
    {"cp": "U+FEFF", "visible": false, "note": "zero width no-break space / BOM, Cf"},
    {"cp": "U+EF0A", "visible": false, "note": "known MathType private-use artifact (existing rule), not all PUA"},
    {"cp": "U+0078", "visible": true, "note": "x"},
    {"cp": "U+0032", "visible": true, "note": "2"},
    {"cp": "U+0028", "visible": true, "note": "left parenthesis"},
    {"cp": "U+2192", "visible": true, "note": "rightwards arrow"},
    {"cp": "U+2212", "visible": true, "note": "minus sign"},
    {"cp": "U+222B", "visible": true, "note": "integral"},
    {"cp": "U+0300", "visible": true, "note": "combining grave, Mn: not in the excluded categories"},
    {"cp": "U+E000", "visible": true, "note": "private use: no evidence that every PUA glyph renders empty"},
    {"cp": "U+EF0B", "visible": true, "note": "private use next to the known artifact: not assumed invisible"}
  ],
  "mathml": [
    {"xml": "<math><mi>&#x2061;</mi></math>", "usable": false, "note": "only function application"},
    {"xml": "<math><mtext>&#x200B;</mtext></math>", "usable": false, "note": "only zero width space"},
    {"xml": "<math><mi>&#xAD;</mi></math>", "usable": false, "note": "only soft hyphen"},
    {"xml": "<math><mn>&#x2062;</mn></math>", "usable": false, "note": "only invisible times"},
    {"xml": "<math><mi>&#x85;</mi></math>", "usable": false, "note": "only next line control"},
    {"xml": "<math><mtext>&#xA0;&#x2003;&#x3000;</mtext></math>", "usable": false, "note": "only space separators"},
    {"xml": "<math><mrow><mo>&#x2061;</mo><mo>&#x2062;</mo><mspace width=\"1em\"/></mrow></math>", "usable": false, "note": "operators and spacing only"},
    {"xml": "<math><mi>&#xEF0A;</mi></math>", "usable": false, "note": "known artifact only"},
    {"xml": "<math><mrow><mi>f</mi><mo>&#x2061;</mo><mi>x</mi></mrow></math>", "usable": true, "note": "invisible operator kept beside visible tokens"},
    {"xml": "<math><mi>x</mi><mo>&#x2062;</mo><mi>y</mi></math>", "usable": true, "note": "invisible times between visible tokens"},
    {"xml": "<math><mrow><mo>(</mo><mo>)</mo></mrow></math>", "usable": true, "note": "delimiters are visible glyphs"},
    {"xml": "<math><mpadded width=\"0pt\"><mi>x</mi></mpadded></math>", "usable": true, "note": "zero width is not taken as invisible without render evidence"},
    {"xml": "<math><mi>&#xE000;</mi></math>", "usable": true, "note": "private use not assumed invisible"},
    {"xml": "<math><mi>&#x200B;x</mi></math>", "usable": true, "note": "one visible code point is enough"}
  ]
}
